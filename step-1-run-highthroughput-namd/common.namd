foreach p [split $env(EXTRA_PAR) ":"] { if {$p ne ""} { parameters $p } }

source cell.tcl
cellBasisVector1   $cbx 0 0
cellBasisVector2   0 $cby 0
cellBasisVector3   0 0 $cbz
cellOrigin         $cox $coy $coz
wrapAll            on

exclude            scaled1-4
1-4scaling         1.0
switching          on
switchdist         10.0
cutoff             12.0
pairlistdist       14.0
vdwForceSwitching  on
LJcorrection       on
PME                yes
PMEGridSpacing     1.0
stepspercycle      10
