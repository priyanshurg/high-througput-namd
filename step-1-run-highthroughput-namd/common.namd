# shared by min.namd and eq.namd  (CHARMM36m, PME, periodic box from cell.tcl)
set ff "/scr/Student-Folders/PRG/PROJECTS/ion-biniding-pockets/files"
structure          ionized.psf
coordinates        ionized.pdb
paraTypeCharmm     on
parameters              $ff/inputs-toppar/par_all36m_prot.prm
parameters              $ff/inputs-toppar/par_all36_na.prm
parameters              $ff/inputs-toppar/par_all36_carb.prm
parameters              $ff/inputs-toppar/par_all36_lipid.prm
parameters              $ff/inputs-toppar/par_all36_cgenff.prm
parameters              $ff/inputs-toppar/par_interface.prm
parameters              $ff/inputs-toppar/toppar_all36_moreions.str
parameters              $ff/inputs-toppar/toppar_all36_nano_lig.str
