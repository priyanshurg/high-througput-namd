parameters              $ff/inputs-toppar/toppar_water_ions.str
parameters              $ff/inputs-toppar/toppar_dum_noble_gases.str
parameters              $ff/inputs-toppar/toppar_ions_won.str
parameters              $ff/inputs-toppar/cam.str
parameters              $ff/inputs-toppar/toppar_all36_prot_arg0.str
parameters              $ff/inputs-toppar/toppar_all36_prot_c36m_d_aminoacids.str
parameters              $ff/inputs-toppar/toppar_all36_prot_fluoro_alkanes.str
parameters              $ff/inputs-toppar/toppar_all36_prot_heme.str
parameters              $ff/inputs-toppar/toppar_all36_prot_na_combined.str
parameters              $ff/inputs-toppar/toppar_all36_prot_retinol.str
parameters              $ff/inputs-toppar/toppar_all36_prot_model.str
parameters              $ff/inputs-toppar/toppar_all36_prot_modify_res.str
parameters              $ff/inputs-toppar/toppar_all36_na_nad_ppi.str
parameters              $ff/inputs-toppar/toppar_all36_na_rna_modified.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_sphingo.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_archaeal.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_bacterial.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_cardiolipin.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_cholesterol.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_dag.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_inositol.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_lnp.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_lps.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_mycobacterial.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_miscellaneous.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_model.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_prot.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_tag.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_yeast.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_hmmm.str
parameters              $ff/inputs-toppar/toppar_all36_lipid_detergent.str
